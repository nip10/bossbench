{
  "name": "@bossbench/core",
  "version": "1.1.0",
  "description": "Core API, repository, actions, and bundled UI for Bossbench.",
  "homepage": "https://github.com/nip10/bossbench/tree/main/packages/core#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nip10/bossbench.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "pg-boss",
    "bossbench",
    "postgres",
    "dashboard",
    "job-queue"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:ui && bun run build:lib",
    "build:lib": "tsup",
    "build:ui": "rm -rf dist/ui && vite build",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:integration": "BOSSBENCH_DATABASE_URL=${BOSSBENCH_DATABASE_URL:-postgres://postgres:postgres@localhost:54329/bossbench} vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "zod": "^3.23.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-router": "^1.168.4",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "nuqs": "^2.9.5",
    "pg-boss": "^12.18.2",
    "recharts": "^2.13.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "tailwind-merge": "^2.5.5",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "pg": ">=8.0.0",
    "pg-boss": ">=12.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
