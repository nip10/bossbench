{
  "name": "@bossbench/fastify",
  "version": "1.0.2",
  "description": "Fastify adapter for Bossbench, an embedded pg-boss dashboard.",
  "homepage": "https://github.com/nip10/bossbench/tree/main/packages/fastify#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nip10/bossbench.git",
    "directory": "packages/fastify"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "pg-boss",
    "bossbench",
    "fastify",
    "adapter",
    "dashboard"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bossbench/core": "workspace:*"
  },
  "peerDependencies": {
    "fastify": ">=4.0.0",
    "pg": ">=8.0.0",
    "pg-boss": ">=12.0.0"
  },
  "devDependencies": {
    "fastify": "^5.2.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
