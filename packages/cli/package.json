{
  "name": "@bossbench/cli",
  "version": "1.0.0",
  "description": "Initializer CLI for Bossbench pg-boss dashboards.",
  "homepage": "https://github.com/nip10/bossbench/tree/main/packages/cli#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nip10/bossbench.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "bossbench": "./dist/index.js"
  },
  "keywords": [
    "pg-boss",
    "bossbench",
    "cli",
    "init",
    "dashboard"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
