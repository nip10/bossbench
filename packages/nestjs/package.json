{
  "name": "@bossbench/nestjs",
  "version": "2.0.0",
  "description": "NestJS adapter for Bossbench, an embedded pg-boss dashboard.",
  "homepage": "https://github.com/nip10/bossbench/tree/main/packages/nestjs#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nip10/bossbench.git",
    "directory": "packages/nestjs"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "pg-boss",
    "bossbench",
    "nestjs",
    "adapter",
    "dashboard"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bossbench/core": "workspace:*"
  },
  "peerDependencies": {
    "@bossbench/express": ">=2.0.1",
    "@bossbench/fastify": ">=1.0.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "fastify": ">=4.0.0",
    "express": ">=4.0.0",
    "pg": ">=8.0.0",
    "pg-boss": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "@bossbench/express": {
      "optional": true
    },
    "@bossbench/fastify": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bossbench/express": "workspace:*",
    "@bossbench/fastify": "workspace:*",
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/platform-fastify": "^10.4.5",
    "@types/express": "^5.0.0",
    "express": "^4.21.2",
    "fastify": "^5.2.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
