{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "cache": false
    },
    "@bossbench/nestjs#build": {
      "dependsOn": [
        "@bossbench/express#build",
        "@bossbench/fastify#build",
        "^build"
      ],
      "outputs": ["dist/**"],
      "cache": false
    },
    "@bossbench/nuxt#build": {
      "dependsOn": ["@bossbench/h3#build", "^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "@bossbench/web#typecheck": {
      "dependsOn": ["@bossbench/web#build"],
      "outputs": []
    },
    "@bossbench/example-with-adonis#typecheck": {
      "dependsOn": ["@bossbench/adonis#build"],
      "outputs": []
    },
    "@bossbench/example-with-next#typecheck": {
      "dependsOn": ["@bossbench/example-with-next#build"],
      "outputs": []
    }
  }
}
