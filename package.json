{
  "name": "bossbench-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source pg-boss dashboard. Drop-in for modern Node backends.",
  "homepage": "https://github.com/nip10/bossbench#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nip10/bossbench.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "keywords": [
    "pg-boss",
    "dashboard",
    "postgres",
    "job-queue",
    "background-jobs"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "test": "turbo test",
    "test:integration": "bun run --filter=@bossbench/core test:integration",
    "typecheck": "turbo typecheck",
    "lint": "oxlint . && biome check .",
    "lint:fix": "oxlint . --fix && biome check --write .",
    "format": "biome format --write .",
    "smoke": "bun scripts/smoke.ts",
    "commitlint": "commitlint --last --verbose",
    "commitlint:edit": "commitlint --config commitlint.config.cjs --edit .git/COMMIT_EDITMSG",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@biomejs/biome": "^2.4.10",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "oxlint": "^1.30.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.12.0"
  }
}
